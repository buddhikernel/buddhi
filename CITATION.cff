repository-code: "https://github.com/buddhikernel/buddhi"
url: "https://github.com/buddhikernel/buddhi"
version: "0.1.0"
license: Apache-2.0
keywords:
  - cognitive budget
  - allocation
  - control plane
  - agent supervision
  - human-in-the-loop
